SECRET_KEY=change-me
# GitHub: https://github.com/settings/developers -> New OAuth App
# Callback URL: http://localhost:5000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google: https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web)
# Redirect URI: http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated admins
ADMIN_EMAILS=
ADMIN_GITHUB_LOGINS=
# DEV_LOGIN=1   # mock login for local testing only, never in production
